PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/drittech

# JWT Configuration
JWT_ACCESS_SECRET=drittech_super_secret_access_jwt_key_2026_production_grade
JWT_REFRESH_SECRET=drittech_super_secret_refresh_jwt_key_2026_production_grade
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
COOKIE_SECRET=drittech_cookie_secret_key_987654321

# Storage Provider (local | s3 | r2)
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./uploads
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=drittech-medical-reports
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Notification Providers
NOTIFICATION_EMAIL_ENABLED=false
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CareFlow Health <notifications@careflow.drittech.com>"

NOTIFICATION_SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

NOTIFICATION_WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# AI Lab Report Summarizer Provider (mock | openai | anthropic | gemini)
AI_PROVIDER=mock
AI_PROVIDER_API_KEY=
